# /etc/nginx/conf.d/bookbuddy.conf  -- alternative to Caddy (docs/deploy/Caddyfile).
#
# 1. Point DNS for api.example.com at the instance and replace the name below.
# 2. Get a certificate:  sudo certbot --nginx -d api.example.com   (certbot fills in the ssl_* lines)
# 3. sudo nginx -t && sudo systemctl reload nginx
# Security group: allow 80 and 443 from anywhere; keep 8080 closed (the app listens on 127.0.0.1 only).

upstream bookbuddy_api {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.example.com;

    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    server_tokens off;

    # Backend caps uploads at MAX_UPLOAD_MB (default 50); keep this a little higher.
    client_max_body_size 60m;

    gzip on;
    gzip_types application/json text/plain;
    # NOTE: text/event-stream is intentionally NOT in gzip_types.

    # ---- Server-Sent Events -----------------------------------------------------------------------------------
    # Chat stream:       POST /api/v1/conversations/{id}/messages/stream
    # Regenerate stream: POST /api/v1/conversations/{id}/messages/{mid}/regenerate (Accept: text/event-stream)
    location ~ ^/api/v1/conversations/[^/]+/messages/(stream|[^/]+/regenerate)$ {
        proxy_pass http://bookbuddy_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_buffering off;           # tokens are forwarded as soon as the app writes them
        proxy_cache off;
        gzip off;
        chunked_transfer_encoding on;
        add_header X-Accel-Buffering "no" always;

        proxy_read_timeout  6m;        # backend SSE timeout is 5 min; keepalive comment every 15 s
        proxy_send_timeout  6m;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Correlation-Id  $http_x_correlation_id;
    }

    # ---- Everything else ----------------------------------------------------------------------------------------
    location / {
        proxy_pass http://bookbuddy_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_read_timeout 5m;         # PDF upload + ingestion kick-off can be slow on small instances
        proxy_request_buffering on;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Correlation-Id  $http_x_correlation_id;
    }
}
