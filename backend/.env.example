MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/bookbuddy?retryWrites=true&w=majority
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CORS_ORIGINS=http://localhost:5173
EMBEDDING_ENABLED=false
EMBEDDING_MODEL_PATH=models/model.onnx
PORT=8080
VECTOR_MODE=atlas   # atlas = try $vectorSearch then brute-force fallback; memory = brute-force only
