# Copy to .env (local) or /etc/bookbuddy/bookbuddy.env (EC2, chmod 600). Never commit real values.
# Format note: systemd EnvironmentFile and docker env_file do not support inline "# comments" or quotes-with-spaces,
# so keep comments on their own lines and values unquoted.

MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/bookbuddy?retryWrites=true&w=majority
# At least 32 random chars: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Comma-separated list of browser origins allowed by CORS (your web app's HTTPS origin in production)
CORS_ORIGINS=http://localhost:5173
EMBEDDING_ENABLED=true
EMBEDDING_MODEL_PATH=models/model.onnx
EMBEDDING_TOKENIZER_PATH=models/tokenizer.json
PORT=8080
# atlas = try $vectorSearch then brute-force fallback; memory = brute-force only
VECTOR_MODE=atlas
# Download model files with: powershell -File scripts/download-e5-model.ps1

# --- Deploy-related (optional; defaults in application.yml) ---
# Transient PDF uploads (deleted after ingestion). Use an absolute path in production.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
# Set to "framework" behind nginx/Caddy so client IP/scheme come from X-Forwarded-* headers
FORWARD_HEADERS_STRATEGY=none
# Soft cap on LLM calls per UTC day, shared by chat/safety/summary/extraction
LLM_DAILY_SOFT_LIMIT=900
# false disables the background job worker (memory extraction etc.)
JOBS_ENABLED=true
# JVM flags used by the Docker image and, if you wish, the systemd unit
JAVA_OPTS=-XX:MaxRAMPercentage=65 -XX:+ExitOnOutOfMemoryError
